<section class="py-12 sm:py-16 bg-[#FAF8F8] min-h-[70vh]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Page Header Banner -->
    <div class="bg-white border border-[#EAE4E4] rounded-sm p-6 sm:p-8 mb-8">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#C62828]">Partner Houses</span>
      <h1 class="font-editorial text-3xl sm:text-4xl font-semibold text-[#222222] mt-1">Brand Directory</h1>
      <p class="text-sm text-neutral-600 mt-2 max-w-2xl">
        Browse our configurable brand showcase.
      </p>

      <div class="mt-6 flex items-center justify-between flex-wrap gap-4 pt-6 border-t border-[#EAE4E4]">
        <!-- Search filter input -->
        <div class="w-full sm:w-80">
          <input
            type="text"
            id="BrandSearchInput"
            placeholder="Filter brands by name..."
            class="w-full px-3.5 py-2 text-xs sm:text-sm border border-[#EAE4E4] rounded-sm focus:outline-none focus:border-[#C62828] bg-[#FAF8F8]"
          >
        </div>

        <!-- 25 vs 18 View Switcher -->
        <div class="flex items-center gap-2">
          <span class="text-xs text-neutral-500 font-medium">Capacity:</span>
          <button type="button" data-view-btn="25" class="px-3.5 py-1.5 text-xs font-semibold rounded-sm bg-[#C62828] text-white transition-colors">25 Brands View</button>
          <button type="button" data-view-btn="18" class="px-3.5 py-1.5 text-xs font-semibold rounded-sm bg-white border border-[#EAE4E4] text-[#222222] hover:border-[#C62828] transition-colors">18 Brands View</button>
        </div>
      </div>
    </div>

    <!-- Brand Directory Grid -->
    <div id="FullBrandsGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
      {%- for block in section.blocks -%}
        <div
          data-brand-card
          data-brand-index="{{ forloop.index }}"
          data-brand-name="{{ block.settings.brand_name | escape }}"
          class="bg-white border border-[#EAE4E4] hover:border-[#C62828] rounded-sm p-5 flex flex-col items-center justify-between text-center transition-all duration-200 min-h-[190px] group"
          {{ block.shopify_attributes }}
        >
          <div class="w-full flex justify-center flex-grow items-center">
            {%- if block.settings.brand_image != blank -%}
              <img 
                src="{{ block.settings.brand_image | img_url: 'medium' }}" 
                alt="{{ block.settings.brand_name | escape }}"
                class="max-h-24 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              >
            {%- else -%}
              <!-- Fallback if no image is uploaded -->
              <span class="text-xs font-bold text-[#C62828] tracking-widest uppercase">BP{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
          </div>
          <div class="w-full pt-3 mt-3 border-t border-[#EAE4E4]">
            <a href="{{ block.settings.brand_link | default: routes.all_products_collection_url }}" class="text-[11px] font-bold uppercase tracking-wider text-[#C62828] hover:underline block">
              View Products &rarr;
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>

  <script>
    (function() {
      const searchInput = document.getElementById('BrandSearchInput');
      const cards = document.querySelectorAll('[data-brand-card]');
      const viewBtns = document.querySelectorAll('[data-view-btn]');
      let currentLimit = 25;

      // Filter by search query
      searchInput?.addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();
        cards.forEach(card => {
          const name = card.getAttribute('data-brand-name').toLowerCase();
          const idx = parseInt(card.getAttribute('data-brand-index'), 10);
          const matchesSearch = name.includes(term);
          const withinLimit = idx <= currentLimit;
          card.classList.toggle('hidden', !(matchesSearch && withinLimit));
        });
      });

      // Toggle 25 vs 18 limit
      viewBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          currentLimit = parseInt(btn.getAttribute('data-view-btn'), 10);
          const term = searchInput ? searchInput.value.toLowerCase() : '';

          cards.forEach(card => {
            const idx = parseInt(card.getAttribute('data-brand-index'), 10);
            const name = card.getAttribute('data-brand-name').toLowerCase();
            const matchesSearch = name.includes(term);
            const withinLimit = idx <= currentLimit;
            card.classList.toggle('hidden', !(matchesSearch && withinLimit));
          });

          viewBtns.forEach(b => {
            const active = b === btn;
            b.className = 'px-3.5 py-1.5 text-xs font-semibold rounded-sm transition-colors ' +
              (active ? 'bg-[#C62828] text-white' : 'bg-white border border-[#EAE4E4] text-[#222222]');
          });
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Brands Directory",
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_image",
          "label": "Brand Logo/Image"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name (for search filtering)"
        },
        {
          "type": "url",
          "id": "brand_link",
          "label": "Brand Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands Directory"
    }
  ]
}
{% endschema %}