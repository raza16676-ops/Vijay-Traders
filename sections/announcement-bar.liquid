{%- if section.blocks.size > 0 -%}
  <div class="bg-[#C62828] text-white text-xs sm:text-[13px] py-2 px-4 border-b border-[#E53935]/30" data-section-id="{{ section.id }}">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      {%- if section.blocks.size > 1 -%}
        <button type="button" data-ann-prev class="hidden sm:inline-flex p-1 hover:opacity-80" aria-label="Previous announcement">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
      {%- endif -%}

      <div class="text-center font-medium tracking-wide mx-auto truncate" aria-live="polite">
        {%- for block in section.blocks -%}
          <p
            data-ann-slide="{{ forloop.index0 }}"
            class="{% unless forloop.first %}hidden{% endunless %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="hover:underline">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <button type="button" data-ann-next class="hidden sm:inline-flex p-1 hover:opacity-80" aria-label="Next announcement">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 1 -%}
    <script>
      (function() {
        const root = document.querySelector('[data-section-id="{{ section.id }}"]');
        if (!root) return;
        const slides = root.querySelectorAll('[data-ann-slide]');
        let idx = 0;
        const show = (next) => {
          slides[idx].classList.add('hidden');
          idx = (next + slides.length) % slides.length;
          slides[idx].classList.remove('hidden');
        };
        root.querySelector('[data-ann-prev]')?.addEventListener('click', () => show(idx - 1));
        root.querySelector('[data-ann-next]')?.addEventListener('click', () => show(idx + 1));
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          setInterval(() => show(idx + 1), {{ section.settings.autoplay_speed | times: 1000 }});
        }
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 5,
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change message every",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "Discover your beauty essentials — Curated skincare & cosmetics."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement",
        "settings": {
          "text": "Discover your beauty essentials — Curated skincare & cosmetics."
        }
      },
      {
        "type": "announcement",
        "settings": {
          "text": "Shop your favourite brands in one place — Value Combo Deals available."
        }
      }
    ]
  }
}
{% endschema %}