{%- liquid
  assign tel_href = 'tel:' | append: settings.contact_phone_tel
  assign wa_href = 'https://wa.me/' | append: settings.whatsapp_number
-%}

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14">
  <div class="flex items-center justify-between border-b border-[#EAE4E4] pb-5 mb-8">
    <div>
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#C62828]">Vijay Traders</span>
      <h1 class="font-editorial text-3xl sm:text-4xl font-semibold text-[#222222] mt-1">Your Shopping Bag</h1>
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="text-xs font-bold uppercase tracking-widest text-[#C62828] hover:underline">
      &larr; Continue Shopping
    </a>
  </div>

  {%- if cart == empty -%}
    <div class="bg-[#FAF8F8] border border-[#EAE4E4] rounded-sm p-10 sm:p-16 text-center max-w-2xl mx-auto my-6">
      <h2 class="font-editorial text-3xl font-semibold text-[#222222]">Your Bag is Currently Empty</h2>
      <p class="text-sm text-neutral-600 mt-2">
        Explore our skincare serums, fluid sunscreens, makeup essentials, or curated combo deals to begin building your routine.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a
          href="{{ routes.all_products_collection_url }}"
          class="px-7 py-3 bg-[#C62828] hover:bg-[#E53935] text-white text-xs font-semibold uppercase tracking-widest rounded-sm transition-colors"
        >
          Explore Products
        </a>
      </div>

      <div class="mt-10 pt-8 border-t border-[#EAE4E4]">
        <p class="text-xs font-bold uppercase tracking-widest text-neutral-500 mb-3">Need Help Choosing a Routine?</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="{{ tel_href }}"
            class="inline-flex items-center gap-2 px-5 py-2.5 border border-[#222222] text-xs font-semibold uppercase tracking-wider rounded-sm hover:border-[#C62828] hover:text-[#C62828]"
          >
            Call Us Now ({{ settings.contact_phone_display | escape }})
          </a>
          <a
            href="{{ wa_href }}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#C62828] text-white text-xs font-semibold uppercase tracking-wider rounded-sm hover:bg-[#E53935]"
          >
            Chat on WhatsApp
          </a>
        </div>
      </div>
    </div>

  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        <!-- Cart Line Items -->
        <div class="lg:col-span-8 divide-y divide-[#EAE4E4] border-t border-b border-[#EAE4E4]">
          {%- for item in cart.items -%}
            <div class="py-5 flex gap-4 sm:gap-6 items-start">
              <a href="{{ item.url }}" class="w-20 h-24 sm:w-24 sm:h-32 bg-[#FAF8F8] border border-[#EAE4E4] rounded-sm overflow-hidden shrink-0">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 240 }}"
                    alt="{{ item.image.alt | default: item.product.title | escape }}"
                    width="120"
                    height="160"
                    class="w-full h-full object-cover"
                  >
                {%- endif -%}
              </a>

              <div class="flex-1 min-w-0">
                <p class="text-[11px] uppercase tracking-widest text-neutral-500 font-semibold">{{ item.product.vendor }}</p>
                <h2 class="text-sm sm:text-base font-semibold text-[#222222] mt-0.5">
                  <a href="{{ item.url }}" class="hover:text-[#C62828]">{{ item.product.title | escape }}</a>
                </h2>

                {%- unless item.product.has_only_default_variant -%}
                  <p class="text-xs text-neutral-500 mt-1">Option: {{ item.variant.title }}</p>
                {%- endunless -%}

                <p class="text-sm font-bold text-[#C62828] mt-2">{{ item.final_price | money }}</p>

                <div class="mt-3 flex items-center gap-4 flex-wrap">
                  <div class="inline-flex items-center border border-[#EAE4E4] rounded-sm bg-white">
                    <label for="Updates_{{ item.key }}" class="sr-only">Quantity</label>
                    <input
                      type="number"
                      name="updates[]"
                      id="Updates_{{ item.key }}"
                      value="{{ item.quantity }}"
                      min="0"
                      class="w-14 py-1 text-center text-xs font-semibold text-[#222222] focus:outline-none"
                    >
                  </div>

                  <button type="submit" name="update" class="text-xs font-semibold text-[#C62828] hover:underline">
                    Update
                  </button>

                  <a
                    href="{{ item.url_to_remove }}"
                    class="text-xs text-neutral-500 hover:text-[#C62828] underline"
                    aria-label="Remove {{ item.title | escape }}"
                  >
                    Remove
                  </a>
                </div>
              </div>

              <div class="text-right shrink-0">
                <span class="text-sm sm:text-base font-bold text-[#222222]">
                  {{ item.final_line_price | money }}
                </span>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Order Summary & Direct Communication Block -->
        <aside class="lg:col-span-4 space-y-6">
          <div class="bg-[#FAF8F8] border border-[#EAE4E4] rounded-sm p-6 space-y-4">
            <h2 class="text-xs font-bold uppercase tracking-widest text-[#222222] pb-3 border-b border-[#EAE4E4]">
              Order Summary ({{ cart.item_count }} Item{% if cart.item_count != 1 %}s{% endif %})
            </h2>

            {%- if cart.total_discount > 0 -%}
              <div class="flex items-center justify-between text-xs text-[#C62828] font-semibold">
                <span>Savings Applied</span>
                <span>&minus; {{ cart.total_discount | money }}</span>
              </div>
            {%- endif -%}

            <div class="flex items-baseline justify-between pt-2">
              <span class="text-sm font-semibold text-[#222222]">Subtotal</span>
              <span class="text-xl font-bold text-[#C62828]">{{ cart.total_price | money }}</span>
            </div>

            <p class="text-xs text-neutral-500 leading-relaxed">
              Shipping and applicable taxes are calculated at checkout.
            </p>

            <button
              type="submit"
              name="checkout"
              class="w-full py-3.5 px-6 bg-[#C62828] hover:bg-[#E53935] text-white text-xs sm:text-sm font-semibold uppercase tracking-widest rounded-sm transition-colors shadow-sm"
            >
              Proceed to Checkout
            </button>
          </div>

          <!-- Required Cart Communication Block: Call Us Now & WhatsApp -->
          <div class="bg-white border border-[#EAE4E4] rounded-sm p-6 space-y-3.5">
            <span class="text-[11px] font-bold uppercase tracking-widest text-[#C62828]">Customer Assistance</span>
            <h3 class="font-editorial text-xl font-semibold text-[#222222]">Have Questions About Your Bag?</h3>
            <p class="text-xs text-neutral-600 leading-relaxed">
              Speak directly with our team for product inquiries or assistance before completing your purchase.
            </p>
            <div class="space-y-2.5 pt-1">
              <a
                href="{{ tel_href }}"
                class="flex items-center justify-center gap-2 w-full py-2.5 px-4 border border-[#222222] text-[#222222] hover:border-[#C62828] hover:text-[#C62828] text-xs font-semibold uppercase tracking-wider rounded-sm transition-colors"
              >
                <span>Call Us Now</span>
              </a>
              <a
                href="{{ wa_href }}"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-[#C62828] hover:bg-[#E53935] text-white text-xs font-semibold uppercase tracking-wider rounded-sm transition-colors"
              >
                <span>Chat on WhatsApp</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}