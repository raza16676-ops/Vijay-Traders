<section
  class="relative overflow-hidden bg-[#FAF8F8] border-b border-[#EAE4E4]"
  id="HeroSlider-{{ section.id }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="Featured Promotions"
>
  <div class="relative h-[440px] sm:h-[520px] lg:h-[600px] w-full">
    {%- for block in section.blocks -%}
      <div
        data-hero-slide="{{ forloop.index0 }}"
        class="absolute inset-0 transition-opacity duration-700 ease-out {% if forloop.first %}opacity-100 z-10{% else %}opacity-0 z-0 pointer-events-none{% endif %}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} of {{ section.blocks.size }}: {{ block.settings.heading | escape }}"
        aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1800 }}"
            alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
            {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
            width="1600"
            height="900"
            class="w-full h-full object-cover object-center"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-neutral-200' }}
        {%- endif -%}

        <div class="absolute inset-0 bg-gradient-to-r from-[#222222]/80 via-[#222222]/45 to-transparent flex items-center">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="max-w-xl text-white space-y-4">
              {%- if block.settings.badge != blank -%}
                <span class="inline-block bg-[#C62828] text-white text-[11px] font-semibold uppercase tracking-[0.2em] px-3 py-1 rounded-sm">
                  {{ block.settings.badge | escape }}
                </span>
              {%- endif -%}

              <h2 class="font-editorial text-4xl sm:text-5xl lg:text-6xl font-semibold leading-[1.1] tracking-tight">
                {{ block.settings.heading | escape }}
              </h2>

              {%- if block.settings.subheading != blank -%}
                <p class="text-sm sm:text-base text-neutral-100 leading-relaxed max-w-md">
                  {{ block.settings.subheading | escape }}
                </p>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <div class="pt-2">
                  <a
                    href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                    class="inline-flex items-center justify-center px-7 py-3.5 bg-[#C62828] hover:bg-[#E53935] text-white text-xs sm:text-sm font-semibold uppercase tracking-widest rounded-sm transition-colors shadow-sm"
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="absolute bottom-5 right-4 sm:right-8 z-20 flex items-center gap-2">
        <button type="button" data-slide-prev class="w-10 h-10 rounded-sm bg-white/90 hover:bg-[#C62828] text-[#222222] hover:text-white flex items-center justify-center transition-colors shadow-sm" aria-label="Previous slide">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button type="button" data-slide-next class="w-10 h-10 rounded-sm bg-white/90 hover:bg-[#C62828] text-[#222222] hover:text-white flex items-center justify-center transition-colors shadow-sm" aria-label="Next slide">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

      <div class="absolute bottom-6 left-4 sm:left-8 z-20 flex items-center gap-2.5" role="tablist">
        {%- for block in section.blocks -%}
          <button
            type="button"
            data-slide-dot="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="Go to slide {{ forloop.index }}"
            class="h-2 transition-all duration-300 rounded-full {% if forloop.first %}w-8 bg-[#C62828]{% else %}w-2 bg-white/70 hover:bg-white{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
    </div>

    <script>
      (function() {
        const root = document.getElementById('HeroSlider-{{ section.id }}');
        if (!root) return;
        const slides = root.querySelectorAll('[data-hero-slide]');
        const dots = root.querySelectorAll('[data-slide-dot]');
        let current = 0;

        const goTo = (nextIdx) => {
          current = (nextIdx + slides.length) % slides.length;
          slides.forEach((s, i) => {
            const active = i === current;
            s.classList.toggle('opacity-100', active);
            s.classList.toggle('z-10', active);
            s.classList.toggle('opacity-0', !active);
            s.classList.toggle('z-0', !active);
            s.classList.toggle('pointer-events-none', !active);
            s.setAttribute('aria-hidden', String(!active));
          });
          dots.forEach((d, i) => {
            const active = i === current;
            d.setAttribute('aria-selected', String(active));
            d.className = 'h-2 transition-all duration-300 rounded-full ' + (active ? 'w-8 bg-[#C62828]' : 'w-2 bg-white/70 hover:bg-white');
          });
        };

        root.querySelector('[data-slide-prev]')?.addEventListener('click', () => goTo(current - 1));
        root.querySelector('[data-slide-next]')?.addEventListener('click', () => goTo(current + 1));
        dots.forEach(d => d.addEventListener('click', () => goTo(Number(d.dataset.slideDot))));
      })();
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero Slideshow",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Banner Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "default": "Your Beauty Essentials"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Headline",
          "default": "Discover Your Everyday Glow"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Supporting Text",
          "default": "Explore beauty and skincare essentials for your routine."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}