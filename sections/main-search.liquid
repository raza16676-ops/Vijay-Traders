<section class="py-12 sm:py-16 bg-[#FAF8F8] min-h-[70vh]" aria-labelledby="SearchHeading-{{ section.id }}">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Search Header & Refinement Bar -->
    <div class="bg-white border border-[#EAE4E4] rounded-sm p-6 sm:p-8 mb-8">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#C62828]">
          Catalogue Search
        </span>
        <h1 id="SearchHeading-{{ section.id }}" class="font-editorial text-3xl sm:text-4xl font-semibold text-[#222222] mt-1">
          {%- if search.performed -%}
            {%- if search.results_count > 0 -%}
              {{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for &ldquo;{{ search.terms | escape }}&rdquo;
            {%- else -%}
              No results found for &ldquo;{{ search.terms | escape }}&rdquo;
            {%- endif -%}
          {%- else -%}
            Search Our Store
          {%- endif -%}
        </h1>
      </div>

      <!-- Search Input Form -->
      <form action="{{ routes.search_url }}" method="get" role="search" class="mt-6 flex flex-col sm:flex-row gap-3">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <div class="relative flex-1">
          <svg class="w-5 h-5 text-neutral-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-4.35-4.35M16.65 10.825a5.825 5.825 0 11-11.65 0 5.825 5.825 0 0111.65 0z"/>
          </svg>
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search by brand, product, or active ingredient (e.g., Minimalist, Niacinamide, SPF)..."
            class="w-full pl-11 pr-4 py-3 text-sm text-[#222222] bg-[#FAF8F8] border border-[#EAE4E4] rounded-sm focus:outline-none focus:bg-white focus:border-[#C62828] transition-colors"
            aria-label="Search products"
          >
        </div>
        <button
          type="submit"
          class="px-7 py-3 bg-[#C62828] hover:bg-[#E53935] text-white text-xs font-semibold uppercase tracking-widest rounded-sm transition-colors shrink-0"
        >
          Search
        </button>
      </form>

      <!-- Quick Popular Searches -->
      <div class="mt-4 flex items-center gap-2 flex-wrap text-xs">
        <span class="text-neutral-400 font-medium">Popular searches:</span>
        <a href="{{ routes.search_url }}?type=product&q=Minimalist" class="px-2.5 py-1 bg-[#FAF8F8] hover:bg-[#C62828] hover:text-white border border-[#EAE4E4] rounded-sm text-neutral-600 transition-colors">Minimalist</a>
        <a href="{{ routes.search_url }}?type=product&q=Niacinamide" class="px-2.5 py-1 bg-[#FAF8F8] hover:bg-[#C62828] hover:text-white border border-[#EAE4E4] rounded-sm text-neutral-600 transition-colors">Niacinamide</a>
        <a href="{{ routes.search_url }}?type=product&q=Sunscreen" class="px-2.5 py-1 bg-[#FAF8F8] hover:bg-[#C62828] hover:text-white border border-[#EAE4E4] rounded-sm text-neutral-600 transition-colors">Sunscreen</a>
        <a href="{{ routes.search_url }}?type=product&q=Vitamin+C" class="px-2.5 py-1 bg-[#FAF8F8] hover:bg-[#C62828] hover:text-white border border-[#EAE4E4] rounded-sm text-neutral-600 transition-colors">Vitamin C</a>
        <a href="{{ routes.search_url }}?type=product&q=Garnier" class="px-2.5 py-1 bg-[#FAF8F8] hover:bg-[#C62828] hover:text-white border border-[#EAE4E4] rounded-sm text-neutral-600 transition-colors">Garnier</a>
      </div>
    </div>

    <!-- Search Results Grid -->
    {%- if search.performed -%}
      {%- paginate search.results by section.settings.products_per_page -%}
        {%- if search.results.size > 0 -%}
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-6">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'card-product', product: item %}
              {%- else -%}
                <article class="bg-white border border-[#EAE4E4] hover:border-[#C62828] rounded-sm p-5 flex flex-col justify-between transition-colors">
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-widest text-[#C62828]">{{ item.object_type }}</span>
                    <h3 class="font-editorial text-lg font-semibold text-[#222222] mt-1">
                      <a href="{{ item.url }}" class="hover:text-[#C62828]">{{ item.title }}</a>
                    </h3>
                    <p class="text-xs text-neutral-600 mt-2 line-clamp-3">{{ item.content | strip_html | truncatewords: 24 }}</p>
                  </div>
                  <a href="{{ item.url }}" class="text-xs font-bold uppercase tracking-wider text-[#C62828] mt-4 inline-block hover:underline">
                    View {{ item.object_type }} &rarr;
                  </a>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <!-- Pagination -->
          {%- if paginate.pages > 1 -%}
            <nav class="mt-12 pt-6 border-t border-[#EAE4E4] flex items-center justify-center gap-2" role="navigation" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider bg-white border border-[#EAE4E4] text-[#222222] hover:border-[#C62828] hover:text-[#C62828] rounded-sm transition-colors">
                  &larr; Previous
                </a>
              {%- endif -%}

              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="w-9 h-9 inline-flex items-center justify-center text-xs font-semibold bg-white border border-[#EAE4E4] text-[#222222] hover:border-[#C62828] hover:text-[#C62828] rounded-sm transition-colors">
                    {{ part.title }}
                  </a>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <span class="w-9 h-9 inline-flex items-center justify-center text-xs font-bold bg-[#C62828] text-white rounded-sm">
                      {{ part.title }}
                    </span>
                  {%- else -%}
                    <span class="w-9 h-9 inline-flex items-center justify-center text-xs text-neutral-400">
                      {{ part.title }}
                    </span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="px-4 py-2 text-xs font-semibold uppercase tracking-wider bg-white border border-[#EAE4E4] text-[#222222] hover:border-[#C62828] hover:text-[#C62828] rounded-sm transition-colors">
                  Next &rarr;
                </a>
              {%- endif -%}
            </nav>
          {%- endif -%}

        {%- else -%}
          <!-- Empty State -->
          <div class="bg-white border border-[#EAE4E4] rounded-sm p-10 text-center max-w-xl mx-auto my-6">
            <h2 class="font-editorial text-2xl font-semibold text-[#222222]">No matching products found</h2>
            <p class="text-sm text-neutral-600 mt-2">
              We couldn't find anything matching &ldquo;{{ search.terms | escape }}&rdquo;. Try checking the spelling or using a broader keyword like <strong>Serum</strong>, <strong>Sunscreen</strong>, or <strong>Cleanser</strong>.
            </p>
            <div class="mt-6">
              <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center justify-center px-6 py-3 bg-[#C62828] hover:bg-[#E53935] text-white text-xs font-semibold uppercase tracking-widest rounded-sm transition-colors">
                Browse All Products
              </a>
            </div>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Search Results",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "Products per page",
      "default": 16
    }
  ]
}
{% endschema %}