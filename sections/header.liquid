{%- liquid
  assign tel_href = 'tel:' | append: settings.contact_phone_tel | default: 'tel:+94112345678'
  assign wa_href = 'https://wa.me/' | append: settings.whatsapp_number | default: 'https://wa.me/94112345678'
-%}

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-[#EAE4E4]" data-section-id="{{ section.id }}">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-4">

      <!-- Left: Mobile Hamburger + Brand Logo (Locked to Single Line with whitespace-nowrap) -->
      <div class="flex items-center gap-3 sm:gap-6 shrink-0">
        <button
          type="button"
          id="HeaderMobileOpen-{{ section.id }}"
          class="lg:hidden p-2 -ml-2 text-[#222222] hover:text-[#C62828] transition-colors"
          aria-label="Open navigation menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>

        <a href="{{ routes.root_url }}" class="flex flex-col group focus:outline-none shrink-0 whitespace-nowrap">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 320 }}"
              alt="{{ shop.name | escape }}"
              class="h-10 w-auto object-contain"
            >
          {%- else -%}
            <span class="font-editorial text-2xl sm:text-3xl font-bold tracking-tight text-[#222222] group-hover:text-[#C62828] transition-colors whitespace-nowrap leading-none">
              VIJAY <span class="text-[#C62828]">TRADERS</span>
            </span>
            <span class="text-[9px] sm:text-[10px] uppercase tracking-[0.25em] text-neutral-500 mt-1 whitespace-nowrap">
              Cosmetics &amp; Skincare
            </span>
          {%- endif -%}
        </a>
      </div>

      <!-- Center: Exact 7-Item Prototype Navigation with Dropdowns & Single-Line Lock -->
      <nav class="hidden lg:flex items-center space-x-6 xl:space-x-7 whitespace-nowrap" aria-label="Main Navigation">

        <!-- 1. Women Mega Menu -->
        <div class="relative group py-6">
          <a href="/collections/women" class="inline-flex items-center gap-1 text-sm font-medium text-[#222222] hover:text-[#C62828] transition-colors whitespace-nowrap">
            <span>Women</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 focus-within:visible focus-within:opacity-100 transition-all duration-200 absolute left-0 top-full w-64 bg-white border border-[#EAE4E4] shadow-xl rounded-sm p-5 z-50 whitespace-normal">
            <div>
              <ul class="space-y-2 text-sm">
                <li><a href="/collections/womens-skin-care" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Skin Care</a></li>
                <li><a href="/collections/womens-face-care" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Face Care</a></li>
                <li><a href="/collections/womens-hair-care" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Hair Care</a></li>
                <li><a href="/collections/womens-body-care" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Body Care</a></li>
                <li><a href="/collections/womens-fragrance" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Women's Fragrance</a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 2. Men Dropdown -->
        <div class="relative group py-6">
          <a href="/collections/all" class="inline-flex items-center gap-1 text-sm font-medium text-[#222222] hover:text-[#C62828] transition-colors whitespace-nowrap">
            <span>Men</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 focus-within:visible focus-within:opacity-100 transition-all duration-200 absolute left-0 top-full w-64 bg-white border border-[#EAE4E4] shadow-xl rounded-sm p-5 z-50 whitespace-normal">
            <ul class="space-y-2 text-sm">
              <li><a href="/collections/mens-skin-care" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Men's Skin Care</a></li>
              <li><a href="/collections/mens-face-care" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Men's Face Care</a></li>
              <li><a href="/collections/mens-hair-care" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Men's Hair Care</a></li>
              <li><a href="/collections/mens-body-care" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Men's Body Care</a></li>
              <li><a href="/collections/mens-fragrances" class="text-neutral-700 hover:text-[#C62828] block py-0.5">Men's Fragrance</a></li>
            </ul>
          </div>
        </div>

        <!-- 3 to 7. Direct Category Links -->
        <a href="/collections/all" class="text-sm font-medium text-[#222222] hover:text-[#C62828] transition-colors whitespace-nowrap">Make-up</a>
        <a href="/collections/all" class="text-sm font-medium text-[#222222] hover:text-[#C62828] transition-colors whitespace-nowrap">Sun Protection</a>
        <a href="/collections/all" class="text-sm font-medium text-[#222222] hover:text-[#C62828] transition-colors whitespace-nowrap">Mother &amp; Baby</a>
        <a href="/pages/brands" class="text-sm font-medium text-[#222222] hover:text-[#C62828] transition-colors whitespace-nowrap">Brands</a>
        <a href="#shopify-section-section_f_combo_deals" class="text-sm font-semibold text-[#C62828] hover:text-[#E53935] transition-colors inline-flex items-center gap-1.5 whitespace-nowrap">
          <span>Combo Deals</span>
          <span class="bg-[#FAF8F8] border border-[#C62828]/30 text-[#C62828] text-[10px] px-1.5 py-0.5 rounded-sm leading-none">SAVE</span>
        </a>
      </nav>

      <!-- Right: Search Trigger, Account, Cart Bag -->
      <div class="flex items-center gap-2 sm:gap-4 shrink-0 whitespace-nowrap">
        <button
          type="button"
          id="HeaderSearchOpen-{{ section.id }}"
          class="p-2 text-[#222222] hover:text-[#C62828] transition-colors flex items-center gap-1.5"
          aria-label="Open product search"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-4.35-4.35M16.65 10.825a5.825 5.825 0 11-11.65 0 5.825 5.825 0 0111.65 0z"/>
          </svg>
          <span class="hidden xl:inline text-xs font-medium uppercase tracking-wider">Search</span>
        </button>

        <a
          href="{{ routes.account_login_url | default: '/account' }}"
          class="hidden sm:inline-flex p-2 text-[#222222] hover:text-[#C62828] transition-colors"
          aria-label="Account"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </a>

        <a
          href="{{ routes.cart_url }}"
          class="relative p-2 text-[#222222] hover:text-[#C62828] transition-colors flex items-center gap-1.5"
          aria-label="Shopping bag"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span class="bg-[#C62828] text-white text-[11px] font-bold min-w-[20px] h-5 px-1.5 rounded-full inline-flex items-center justify-center">
            {{ cart.item_count }}
          </span>
        </a>
      </div>

    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="HeaderMobileBackdrop-{{ section.id }}" class="fixed inset-0 bg-black/50 z-50 hidden opacity-0 transition-opacity duration-300"></div>
<aside
  id="HeaderMobileDrawer-{{ section.id }}"
  class="fixed top-0 left-0 bottom-0 w-[85%] max-w-sm bg-white z-50 transform -translate-x-full transition-transform duration-300 flex flex-col justify-between overflow-y-auto"
  aria-label="Mobile Navigation Drawer"
>
  <div>
    <div class="p-4 border-b border-[#EAE4E4] flex items-center justify-between bg-[#FAF8F8]">
      <span class="font-editorial text-xl font-bold tracking-tight text-[#222222]">
        VIJAY <span class="text-[#C62828]">TRADERS</span>
      </span>
      <button type="button" id="HeaderMobileClose-{{ section.id }}" class="p-2 text-[#222222] hover:text-[#C62828]" aria-label="Close menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <nav class="p-4 divide-y divide-[#EAE4E4]">
      <a href="/collections/all" class="block py-3.5 text-base font-semibold text-[#222222] hover:text-[#C62828]">Women</a>
      <a href="/collections/all" class="block py-3.5 text-base font-semibold text-[#222222] hover:text-[#C62828]">Men</a>
      <a href="/collections/all" class="block py-3.5 text-base font-semibold text-[#222222] hover:text-[#C62828]">Make-up</a>
      <a href="/collections/all" class="block py-3.5 text-base font-semibold text-[#222222] hover:text-[#C62828]">Sun Protection</a>
      <a href="/collections/all" class="block py-3.5 text-base font-semibold text-[#222222] hover:text-[#C62828]">Mother &amp; Baby</a>
      <a href="/pages/brands" class="block py-3.5 text-base font-semibold text-[#222222] hover:text-[#C62828]">Brands</a>
      <a href="#shopify-section-section_f_combo_deals" class="block py-3.5 text-base font-bold text-[#C62828]">Combo Deals</a>
    </nav>
  </div>

  <div class="p-4 bg-[#FAF8F8] border-t border-[#EAE4E4] space-y-2.5">
    <p class="text-xs uppercase tracking-wider text-neutral-500 font-semibold">Need Assistance?</p>
    <a href="{{ tel_href }}" class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-white border border-[#EAE4E4] text-[#222222] text-xs font-semibold uppercase tracking-wider rounded-sm hover:border-[#C62828]">
      Call Us Now
    </a>
    <a href="{{ wa_href }}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-[#C62828] text-white text-xs font-semibold uppercase tracking-wider rounded-sm hover:bg-[#E53935]">
      Chat on WhatsApp
    </a>
  </div>
</aside>

<!-- Global Search Overlay Modal -->
<div
  id="HeaderSearchModal-{{ section.id }}"
  class="fixed inset-0 bg-black/60 z-50 hidden items-start justify-center pt-12 sm:pt-20 px-4"
  role="dialog"
  aria-modal="true"
>
  <div class="bg-white w-full max-w-3xl rounded-sm shadow-2xl border border-[#EAE4E4] overflow-hidden">
    <form action="{{ routes.search_url }}" method="get" role="search" class="p-4 sm:p-5 border-b border-[#EAE4E4] flex items-center gap-3">
      <input type="hidden" name="type" value="product">
      <svg class="w-5 h-5 text-[#C62828] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M16.65 10.825a5.825 5.825 0 11-11.65 0 5.825 5.825 0 0111.65 0z"/>
      </svg>
      <input
        type="search"
        name="q"
        id="HeaderSearchInput-{{ section.id }}"
        placeholder="Search serums, sunscreens, lip tints, combo deals..."
        class="w-full text-sm sm:text-base text-[#222222] placeholder-neutral-400 focus:outline-none"
        autocomplete="off"
      >
      <button type="button" id="HeaderSearchClose-{{ section.id }}" class="p-1.5 text-neutral-500 hover:text-[#C62828] text-xs uppercase tracking-wider font-semibold">
        ESC
      </button>
    </form>
    <div id="HeaderSearchResults-{{ section.id }}" class="p-4 sm:p-6 max-h-[65vh] overflow-y-auto bg-[#FAF8F8]">
      <p class="text-xs text-neutral-500 uppercase tracking-wider">Type a product name above to search your live Shopify catalogue.</p>
    </div>
  </div>
</div>

<script>
  (function() {
    const sId = '{{ section.id }}';
    const openBtn = document.getElementById('HeaderMobileOpen-' + sId);
    const closeBtn = document.getElementById('HeaderMobileClose-' + sId);
    const drawer = document.getElementById('HeaderMobileDrawer-' + sId);
    const backdrop = document.getElementById('HeaderMobileBackdrop-' + sId);

    const toggleMobile = (isOpen) => {
      if (!drawer || !backdrop) return;
      if (isOpen) {
        backdrop.classList.remove('hidden');
        requestAnimationFrame(() => {
          backdrop.classList.remove('opacity-0');
          drawer.classList.remove('-translate-x-full');
        });
      } else {
        backdrop.classList.add('opacity-0');
        drawer.classList.add('-translate-x-full');
        setTimeout(() => backdrop.classList.add('hidden'), 300);
      }
    };
    openBtn?.addEventListener('click', () => toggleMobile(true));
    closeBtn?.addEventListener('click', () => toggleMobile(false));
    backdrop?.addEventListener('click', () => toggleMobile(false));

    const searchOpen = document.getElementById('HeaderSearchOpen-' + sId);
    const searchClose = document.getElementById('HeaderSearchClose-' + sId);
    const searchModal = document.getElementById('HeaderSearchModal-' + sId);
    const searchInput = document.getElementById('HeaderSearchInput-' + sId);

    searchOpen?.addEventListener('click', () => {
      searchModal?.classList.remove('hidden');
      searchModal?.classList.add('flex');
      searchInput?.focus();
    });
    searchClose?.addEventListener('click', () => {
      searchModal?.classList.add('hidden');
      searchModal?.classList.remove('flex');
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    }
  ]
}
{% endschema %}