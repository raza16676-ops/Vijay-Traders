{%- liquid
  assign tel_href = 'tel:' | append: settings.contact_phone_tel | default: 'tel:+94112345678'
  assign wa_href = 'https://wa.me/' | append: settings.whatsapp_number | default: 'https://wa.me/94112345678'
-%}

<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-14">
  <header class="text-center max-w-2xl mx-auto">
    <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#C62828]">Customer Care</span>
    <h1 class="font-editorial text-4xl sm:text-5xl font-semibold text-[#222222] mt-1">
      {{ page.title | default: 'Contact Vijay Traders' | escape }}
    </h1>
    <p class="text-sm text-neutral-600 mt-2">
      Reach our team directly via phone or WhatsApp for product questions, store hours, or order support.
    </p>
  </header>

  <!-- Direct Communication Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-[#FAF8F8] border border-[#EAE4E4] rounded-sm p-8 flex flex-col justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-[#C62828]">Telephone Support</span>
        <h2 class="font-editorial text-2xl font-semibold mt-1">Speak With Our Store Team</h2>
        <p class="text-sm text-neutral-600 mt-2">
          Contact Number: <strong>{{ settings.contact_phone_display | default: '+94 11 234 5678 (Placeholder)' | escape }}</strong>
        </p>
      </div>
      <div class="mt-6">
        <a
          href="{{ tel_href }}"
          class="inline-flex items-center justify-center w-full py-3 px-6 border border-[#222222] hover:border-[#C62828] text-[#222222] hover:text-[#C62828] text-xs font-semibold uppercase tracking-widest rounded-sm transition-colors"
        >
          Call Us Now
        </a>
      </div>
    </div>

    <div class="bg-[#FAF8F8] border border-[#EAE4E4] rounded-sm p-8 flex flex-col justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-[#C62828]">Direct Messaging</span>
        <h2 class="font-editorial text-2xl font-semibold mt-1">WhatsApp Beauty Concierge</h2>
        <p class="text-sm text-neutral-600 mt-2">
          WhatsApp: <strong>+{{ settings.whatsapp_number | default: '94112345678' | escape }}</strong> (General customer communication link).
        </p>
      </div>
      <div class="mt-6">
        <a
          href="{{ wa_href }}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center w-full py-3 px-6 bg-[#C62828] hover:bg-[#E53935] text-white text-xs font-semibold uppercase tracking-widest rounded-sm transition-colors"
        >
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Policy Sections -->
  <div class="space-y-8 border-t border-[#EAE4E4] pt-12">
    <div id="shipping" class="space-y-2">
      <h2 class="font-editorial text-2xl font-semibold text-[#222222]">Shipping Information</h2>
      <p class="text-sm text-neutral-600 leading-relaxed">
        {{ section.settings.shipping_text | escape }}
      </p>
    </div>
    <div id="returns" class="space-y-2">
      <h2 class="font-editorial text-2xl font-semibold text-[#222222]">Returns &amp; Refund Policy</h2>
      <p class="text-sm text-neutral-600 leading-relaxed">
        {{ section.settings.returns_text | escape }}
      </p>
    </div>
    <div id="privacy" class="space-y-2">
      <h2 class="font-editorial text-2xl font-semibold text-[#222222]">Privacy Policy</h2>
      <p class="text-sm text-neutral-600 leading-relaxed">
        {{ section.settings.privacy_text | escape }}
      </p>
    </div>
    <div id="terms" class="space-y-2">
      <h2 class="font-editorial text-2xl font-semibold text-[#222222]">Terms &amp; Conditions</h2>
      <p class="text-sm text-neutral-600 leading-relaxed">
        {{ section.settings.terms_text | escape }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact & Policies Page",
  "settings": [
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping Policy Copy",
      "default": "Replace this placeholder with Vijay Traders' approved islandwide delivery timelines, Colombo express dispatch rates, and free-shipping thresholds."
    },
    {
      "type": "textarea",
      "id": "returns_text",
      "label": "Returns Policy Copy",
      "default": "Replace this placeholder with Vijay Traders' hygiene seal requirements for cosmetics, damaged-in-transit claim window, and exchange procedure."
    },
    {
      "type": "textarea",
      "id": "privacy_text",
      "label": "Privacy Policy Copy",
      "default": "Replace with Vijay Traders' official customer data and privacy policy."
    },
    {
      "type": "textarea",
      "id": "terms_text",
      "label": "Terms & Conditions Copy",
      "default": "Replace with Vijay Traders' official Terms of Service prior to launch."
    }
  ]
}
{% endschema %}